APP_HOST=127.0.0.1
APP_PORT=8765
DATABASE_PATH=data/app.db

APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_CHAT_ENDPOINT=https://api.apimart.ai/v1/chat/completions
APIMART_UPLOAD_IMAGES_ENDPOINT=https://api.apimart.ai/v1/uploads/images
APIMART_TASK_ENDPOINT_BASE=https://api.apimart.ai/v1/tasks

GEMINI_PROVIDER=mock
GEMINI_REQUEST_FORMAT=native
GEMINI_ENDPOINT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

SEEDANCE_PROVIDER=mock
SEEDANCE_API_KEY=
SEEDANCE_ENDPOINT=https://api.apimart.ai/v1/videos/generations
SEEDANCE_MODEL=seedance-2.0
SEEDANCE_RESOLUTION=720p
SEEDANCE_RATIO=9:16
SEEDANCE_GENERATE_AUDIO=false

PUBLIC_BASE_URL=
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YTDLP_BIN=yt-dlp

# Standalone TK login and completed-video collection helpers.
TK_CHROME_PATH=
TK_CHROME_DEBUG_PORT=9333
TK_CHROME_PROFILE_DIR=runtime/chrome_profile
TK_LOGIN_URL=https://seller.tiktokglobalshop.com/account/login

# Logged-in TK backend API collection.
# Use Chrome DevTools Network to find the completed-video list API, then set it here.
TK_CDP_HOST=127.0.0.1

# Method 1: listen to Network requests while you operate the logged-in TK backend page.
TK_MONITOR_PAGE_URL_CONTAINS=tiktok
TK_MONITOR_URL_CONTAINS=
TK_MONITOR_METHODS=GET,POST
TK_MONITOR_ACCOUNT=tk_completed
TK_MONITOR_TIMEOUT=120
TK_MONITOR_MAX_RESPONSES=20
TK_MONITOR_IMPORT_RESPONSE_BODY=true

# Method 2: actively request the confirmed TK backend API from the logged-in page context.
TK_BACKEND_PAGE_URL_CONTAINS=tiktok
TK_BACKEND_API_URL=
TK_BACKEND_API_METHOD=GET
TK_BACKEND_API_HEADERS={}
TK_BACKEND_API_BODY=
TK_BACKEND_ACCOUNT=tk_completed
TK_BACKEND_PAGE_START=1
TK_BACKEND_PAGE_SIZE=50
TK_BACKEND_PAGE_PARAM=page
TK_BACKEND_PAGE_SIZE_PARAM=page_size
TK_BACKEND_CURSOR_PARAM=
TK_BACKEND_INITIAL_CURSOR=
TK_BACKEND_NEXT_CURSOR_FIELDS=next_cursor,nextCursor,next_page_token,nextPageToken
TK_BACKEND_HAS_MORE_FIELDS=has_more,hasMore,has_next,hasNext
TK_BACKEND_MAX_PAGES=1
TK_BACKEND_REQUEST_TIMEOUT=30
TK_BACKEND_STOP_ON_EMPTY=true

TK_EMAIL_HOST=
TK_EMAIL_PORT=993
TK_EMAIL_USER=
TK_EMAIL_PASSWORD=
TK_EMAIL_MAILBOX=INBOX
TK_EMAIL_SENDER_FILTER=
TK_EMAIL_SUBJECT_FILTER=
TK_EMAIL_CODE_REGEX=\b(\d{4,8})\b
